# Database URL (SQLite for local development, Postgres for production)
DATABASE_URL="file:./dev.db"

# Bright Data API Credentials
BRIGHT_DATA_API_KEY="your_bright_data_api_key_here"
BRIGHT_DATA_CUSTOMER_ID="your_bright_data_customer_id_here"
BRIGHT_DATA_ZONE="your_bright_data_zone_here"

# Simulation Mode: Set to "true" to run mock scrapers & mock AI self-healing locally
BRIGHT_DATA_MOCK="true"

# Server Port
PORT=3000
